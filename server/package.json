{
	"name": "my-app",
	"type": "module",
	"imports": {
		"#features/*": "./src/features/*.ts",
		"#services/*": "./src/shared/services/*.ts",
		"#common/*": "./src/common/*.ts",
		"#integrations/*": "./src/integrations/*.ts",
		"#helpers/*": "./src/helpers/*.ts",
		"#scripts/*": "./src/scripts/*.ts"
	},
	"scripts": {
		"mock": "MOCK_TEXT=6ING123 MOCK_STATE=CA bun run dev",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run src/index.ts",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"check-types": "tsc --noEmit",
		"eslint": "eslint",
		"lint": "bun run eslint && bun run check-types"
	},
	"dependencies": {
		"@logtape/hono": "2.3.2",
		"@logtape/logtape": "2.3.2",
		"@socket.io/bun-engine": "0.1.2",
		"date-fns": "4.1.0",
		"hono": "~4.13.13",
		"nanoid": "6.0.1",
		"socket.io": "~4.8.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@tsconfig/bun": "1.0.12",
		"@types/bun": "1.4.4",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.28",
		"eslint": "9.39.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.4",
		"eslint-plugin-import-x": "4.16.1",
		"eslint-plugin-prettier": "5.5.4",
		"globals": "17.14.0",
		"memfs": "4.50.0",
		"prettier": "3.9.10",
		"type-fest": "5.6.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.55.0",
		"vitest": "5.1.0"
	}
}
